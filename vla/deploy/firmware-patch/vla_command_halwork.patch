 extern u8 Usart1_Receive_buf[1];   /* 2026-11-08 USB 遥控接收缓冲（定义在 usart.c） */
 #include "Lidar.h"
+/* ===== VLA continuous (v, omega) command (deploy/firmware-patch) ===== */
+#include "vla_cmd.h"
+
 /**************************************************************************
 Function: Receive interrupt function
 Input   : none
@@ -31,6 +34,12 @@
 u8 Usart3_Receive_buf[1];          //串口3接收中断数据存放的缓冲区
 u8 Usart3_Receive;                 //从串口3读取的数据
 volatile uint32_t Remote_Last_Cmd_Tick=0;   /* 2026-11-08 组合运动补丁：最后一次有效遥控指令时刻(ms) */
+/* VLA state: last valid #V<v_mm_s>,<w_mrad_s>; frame (consumed in control.c) */
+volatile int16_t VLA_V_mm_s = 0;
+volatile int16_t VLA_W_mrad_s = 0;
+volatile uint32_t VLA_Last_Tick = 0;
+volatile uint8_t VLA_Active = 0;
+
 
 /* 2026-11-08 USB 遥控通道：遥控字符解析抽成独立函数，
    USART3（蓝牙）与 USART1（USB Type-C/CH9102）都可调用，网页既能走 USB 也能走蓝牙。 */
@@ -104,6 +113,20 @@
 {
 	if (ch == '#') { DP2_Param_Active = 1; DP2_Param_Len = 0; return; }
 	if (!DP2_Param_Active) return;
+	/* VLA frame: #V<v_mm_s>,<w_mrad_s>;  (new branch; #name=value; path unchanged) */
+	if (ch == ';' && DP2_Param_Buf[0] == 'V') {
+		int16_t v_mm_s = 0;
+		int16_t w_mrad_s = 0;
+		DP2_Param_Active = 0;
+		DP2_Param_Buf[DP2_Param_Len] = 0;
+		if (vla_parse_vw(DP2_Param_Buf, &v_mm_s, &w_mrad_s)) {
+			VLA_V_mm_s = v_mm_s;
+			VLA_W_mrad_s = w_mrad_s;
+			VLA_Last_Tick = HAL_GetTick();
+			VLA_Active = 1;
+		}
+		return;
+	}
 	if (ch == ';') { DP2_Param_Active = 0; DP2_Param_Buf[DP2_Param_Len]=0; DP2_ApplyParam(DP2_Param_Buf); return; }
 	if (DP2_Param_Len < sizeof(DP2_Param_Buf)-1) DP2_Param_Buf[DP2_Param_Len++] = (char)ch;
 }
