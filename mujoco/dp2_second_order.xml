<!-- WHEELTEC B585 DP2 二阶模型（带摆杆）：两轮 + 车身 + 摆杆
     参数：车身 0.9kg、轮 0.04kg×2（r=0.0335，轮距 ±0.095）、摆杆 0.1kg（长 0.39m，质心在中间）
     车身与摆杆用铰链连接（θ2），车身与地面用 pitch 铰链（θ1） -->
<mujoco model="dp2_second_order">
  <option timestep="0.005" gravity="0 0 -9.81" integrator="Euler"/>
  <default>
    <geom friction="0.9 0.01 0.001" solref="0.005 1"/>
    <joint damping="0.0005"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="6 6 0.1" rgba="0.45 0.45 0.5 1"/>
    <body name="chassis" pos="0 0 0.0335">
      <joint name="sx" type="slide" axis="1 0 0" damping="0.002"/>
      <joint name="sz" type="slide" axis="0 0 1" damping="0.002"/>
      <joint name="pitch" type="hinge" axis="0 1 0" damping="0.002"/>
      <geom name="body" type="box" size="0.035 0.045 0.063" pos="0 0 0.063" mass="0.9" rgba="0.9 0.55 0.2 1"/>
      <body name="wheel_l" pos="0 -0.095 0">
        <joint name="wl" type="hinge" axis="0 1 0" damping="0.001"/>
        <geom name="wheel_l_g" type="cylinder" size="0.0335 0.011" euler="90 0 0" mass="0.04" rgba="0.2 0.4 0.9 1"/>
      </body>
      <body name="wheel_r" pos="0 0.095 0">
        <joint name="wr" type="hinge" axis="0 1 0" damping="0.001"/>
        <geom name="wheel_r_g" type="cylinder" size="0.0335 0.011" euler="90 0 0" mass="0.04" rgba="0.2 0.4 0.9 1"/>
      </body>
      <body name="pole" pos="0 0 0.126">
        <joint name="pole_hinge" type="hinge" axis="0 1 0" damping="0.0008"/>
        <geom name="pole_g" type="capsule" fromto="0 0 0 0 0 0.39" size="0.006" mass="0.1" rgba="0.85 0.2 0.2 1"/>
        <geom name="pole_tip" type="sphere" pos="0 0 0.39" size="0.012" mass="0.001" rgba="0.2 0.9 0.2 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="torque_l" joint="wl" ctrllimited="true" ctrlrange="-0.0402 0.0402"/>
    <motor name="torque_r" joint="wr" ctrllimited="true" ctrlrange="-0.0402 0.0402"/>
  </actuator>
</mujoco>
