<!-- WHEELTEC B585 DP2 无杆版（一阶）：两轮 + 车身，仅平面内运动
     参数按实测：轮半径 0.0335 m、轮质量 0.04 kg×2、车身 0.9 kg、轮距 ±0.095 m
     电机：单轮最大推力 1.2 N → 力矩上限 1.2×0.0335 = 0.0402 N·m -->
<mujoco model="dp2_nopole">
  <option timestep="0.005" gravity="0 0 -9.81" integrator="Euler"/>
  <default>
    <geom friction="0.9 0.01 0.001" solref="0.005 1"/>
    <joint damping="0.0005"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="6 6 0.1" rgba="0.5 0.5 0.5 1" pos="0 0 0"/>
    <body name="chassis" pos="0 0 0.0335">
      <joint name="sx" type="slide" axis="1 0 0" damping="0.002"/>
      <joint name="sz" type="slide" axis="0 0 1" damping="0.002"/>
      <joint name="pitch" type="hinge" axis="0 1 0" damping="0.002"/>
      <geom name="body_geom" type="box" size="0.035 0.045 0.085" pos="0 0 0.09" mass="0.9" rgba="0.9 0.5 0.1 1"/>
      <body name="wheel_l" pos="0 -0.095 0">
        <joint name="wl" type="hinge" axis="0 1 0" damping="0.001"/>
        <geom name="wheel_l_g" type="cylinder" size="0.0335 0.012" euler="90 0 0" mass="0.04" rgba="0.2 0.4 0.9 1"/>
      </body>
      <body name="wheel_r" pos="0 0.095 0">
        <joint name="wr" type="hinge" axis="0 1 0" damping="0.001"/>
        <geom name="wheel_r_g" type="cylinder" size="0.0335 0.012" euler="90 0 0" mass="0.04" rgba="0.2 0.4 0.9 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="torque_l" joint="wl" ctrllimited="true" ctrlrange="-0.0402 0.0402"/>
    <motor name="torque_r" joint="wr" ctrllimited="true" ctrlrange="-0.0402 0.0402"/>
  </actuator>
</mujoco>
